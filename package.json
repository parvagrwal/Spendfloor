{
  "name": "spendfloor",
  "version": "0.1.0",
  "private": true,
  "description": "SpendFloor: one agent spend policy, enforced on-chain on Base Sepolia and Solana devnet.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sdk",
    "agent",
    "rebalance-bot",
    "policy",
    "cli",
    "conformance",
    "relay"
  ],
  "scripts": {
    "check-toolchain": "bash scripts/check-toolchain.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test policy/test/*.test.ts test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 sdk/test/sdk.test.ts relay/test/submitter.test.ts"
  },
  "dependencies": {
    "@scure/base": "1.2.6",
    "@solana/web3.js": "1.99.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
