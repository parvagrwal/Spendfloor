{
  "name": "spendfloor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpendFloor: one agent spend policy, enforced on-chain on Base Sepolia and Solana devnet.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sdk",
    "agent",
    "rebalance-bot",
    "policy",
    "cli",
    "conformance",
    "relay"
  ],
  "scripts": {
    "check-toolchain": "bash scripts/check-toolchain.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p operator/tsconfig.json",
    "test": "tsx --test policy/test/*.test.ts test/*.test.ts operator/test/*.test.ts && TSX_TSCONFIG_PATH=frontend/tsconfig.json tsx --test frontend/test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 sdk/test/sdk.test.ts relay/test/submitter.test.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "tsx operator/server.ts --serve-static"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@scure/base": "1.2.6",
    "@solana/web3.js": "1.99.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
